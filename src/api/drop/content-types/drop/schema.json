{
  "kind": "collectionType",
  "collectionName": "drops",
  "info": {
    "singularName": "drop",
    "pluralName": "drops",
    "displayName": "Drop"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "theme": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "culturalNarrative": {
      "type": "blocks"
    },
    "causeNarrative": {
      "type": "blocks"
    },
    "releaseDate": {
      "type": "date"
    },
    "season": {
      "type": "string"
    },
    "limitedEdition": {
      "type": "boolean",
      "default": true
    },
    "artists": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::artist.artist",
      "inversedBy": "relatedDrops"
    },
    "ngos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ngo.ngo",
      "inversedBy": "relatedDrops"
    },
    "designs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::design.design",
      "mappedBy": "relatedDrop"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "relatedDrop"
    },
    "impactSummary": {
      "type": "text"
    },
    "transparencyNote": {
      "type": "text"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}
