{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "shortBio": {
      "type": "text",
      "required": true
    },
    "fullBio": {
      "type": "blocks",
      "required": true
    },
    "artisticStyle": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string",
      "required": true
    },
    "socialLinks": {
      "type": "component",
      "component": "platform.social-links",
      "repeatable": true
    },
    "featured": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "seoTitle": {
      "type": "string",
      "required": false
    },
    "seoDescription": {
      "type": "text"
    },
    "relatedDesigns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::design.design"
    },
    "relatedDrops": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::drop.drop"
    }
  }
}
