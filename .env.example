# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://your-strapi-app.up.railway.app
FRONTEND_URL=https://your-frontend.vercel.app

# Secrets (generate each with: openssl rand -base64 32)
APP_KEYS=key1,key2
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (Railway provides DATABASE_URL automatically)
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=true

# Local development overrides
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=arteffect
# DATABASE_USERNAME=your_username
# DATABASE_PASSWORD=
# DATABASE_SSL=false
